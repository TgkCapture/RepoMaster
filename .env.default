# Which config to load: development | production | testing
FLASK_CONFIG=development

# Required in production. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

GITHUB_APP_ID=

GITHUB_APP_NAME=

GITHUB_PRIVATE_KEY_PATH=

# User sign-in: the GitHub App's Client ID and a generated Client secret
GITHUB_CLIENT_ID=

GITHUB_CLIENT_SECRET=

# Optional: exact OAuth callback URL (set when behind a reverse proxy), e.g. https://your-domain/github/callback
GITHUB_OAUTH_CALLBACK_URL=

# Webhooks: the secret entered on the GitHub App's webhook settings (same value in both places).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=

# Optional: where the SQLite database is stored (default: instance/repomaster.db)
DATABASE_PATH=

# Days a deleted repository stays archived and restorable before it is really deleted (0 = delete at once).
# Run `flask --app run run-scheduled-deletions` regularly (e.g. hourly from cron) to carry out due deletions.
SOFT_DELETE_DAYS=7
